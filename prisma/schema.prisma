// Schema do Prisma - Sistema de Autenticação Intermediária
// Saiba mais em: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  usuario
  admin
}

// Aplicação cliente que consome este provedor de identidade — o nível de
// isolamento ACIMA da organização. Organizacao/Membro (multi-tenant) resolvem
// "times dentro de um app"; Aplicacao resolve "apps diferentes, de clientes
// diferentes, que não se conhecem". Sem ela, o e-mail é único no sistema
// inteiro e dois clientes com o mesmo usuário final colidem.
model Aplicacao {
  id       String @id @default(cuid())
  nome     String
  // Identificador PÚBLICO, enviado pelo SDK no header x-aplicacao-id. Ele
  // seleciona o tenant e nada mais: entra no `where` de toda leitura e no
  // `data` de toda escrita, mas NUNCA autoriza — autorização continua vindo
  // do access token, como já vinha. Tratar isto como credencial seria repetir
  // o erro clássico de confundir identificação com autenticação.
  clientId String @unique
  // Segredo para chamadas servidor-a-servidor. Só o hash é persistido, mesmo
  // princípio de Usuario.senhaHash e TokenAtualizacao.tokenHash — quem tem o
  // banco não consegue se passar pela aplicação.
  clientSecretHash String?
  // Origens completas (esquema://host[:porta]) de onde esta aplicação pode
  // falar. Faz dois trabalhos que não dá pra separar: allowlist de origem das
  // requisições do navegador e origem esperada do WebAuthn. Uma origem errada
  // aceita aqui é uma passkey aceita de um site que não é do cliente.
  origens  String[]
  // RP ID do WebAuthn: o domínio exato (sem esquema nem porta) a que as
  // passkeys desta aplicação ficam presas. Era env var global
  // (PASSKEY_RP_ID); com clientes em domínios próprios, tem que ser por
  // aplicação, porque uma credencial só vale na origem em que nasceu.
  passkeyRpId String?
  // URLs de retorno do login hospedado (OpenID Connect): pra onde /autorizar
  // pode mandar o código. Comparação EXATA de string, sem prefixo nem curinga
  // — um redirect_uri aceito por prefixo é um código entregue a quem controlar
  // qualquer caminho sob aquele domínio.
  redirectUris String[] @default([])
  // Cliente PÚBLICO (SPA ou app sem backend, que não guarda segredo) ou
  // CONFIDENCIAL (tem backend e guarda o client secret). Confidencial precisa
  // do segredo pra trocar código e renovar tokens (/api/oidc/token e
  // /api/auth/atualizar com token no corpo): sem isso, um refresh token vazado
  // (log, banco do cliente, proxy) seria resgatado por qualquer um com o
  // client_id, que é público (RFC 6749 §6). Padrão: confidencial.
  clientePublico Boolean @default(false)
  // Marca nos e-mails enviados aos usuários finais desta aplicação (ver
  // MarcaEmail em src/lib/email.ts). Todos opcionais: sem eles, os e-mails
  // saem com o nome da aplicação no assunto e o remetente do provedor.
  // Remetente precisa ser de um domínio verificado no Resend do provedor.
  emailRemetente String?
  // Endereço base dos links nos e-mails (verificar e-mail, redefinir senha,
  // aceitar convite). Sem ele, os links apontam pras páginas do próprio
  // provedor (BASE_URL) — que funcionam pra qualquer aplicação, porque o token
  // do link já diz de quem é a conta.
  urlLinks       String?
  logoUrl        String?
  ativa    Boolean @default(true)
  // A aplicação de primeira parte: o próprio painel deste projeto. Requisição
  // que chega sem x-aplicacao-id (o dashboard, as páginas de login, tudo que
  // já existia) cai nela — é o que mantém o app atual funcionando sem precisar
  // reescrever o front. Só UMA linha pode ter padrao = true, garantido por
  // índice único parcial criado à mão na migration (o Prisma não expressa
  // índice parcial no schema).
  padrao   Boolean @default(false)
  // Self-service: a organização (da aplicação padrão, ou seja, um cliente do
  // provedor com conta no painel) que criou e gerencia esta aplicação. Nulo =
  // criada por quem opera o provedor, ou a própria aplicação padrão. SetNull:
  // se a organização dona some (conta excluída), a aplicação continua no ar
  // pros usuários finais dela e passa a ser gerida só pelo operador.
  organizacaoDonaId String?
  organizacaoDona   Organizacao? @relation("AplicacoesDaOrganizacao", fields: [organizacaoDonaId], references: [id], onDelete: SetNull)
  // Aprovada por quem opera o provedor. Aplicação self-service nasce SEM
  // aprovação e, até lá, fala em nome do provedor com rédea curta: e-mails
  // sem logo nem links próprios e com cota baixa por hora, e o IP de usuário
  // final declarado pelo backend é ignorado. Sem isso, uma conta recém-criada
  // mandava phishing ("Banco X — conta bloqueada", links pro site dela) pelo
  // domínio verificado do provedor. Criada pelo operador: já nasce aprovada.
  aprovada Boolean @default(false)
  // Desativada POR QUEM OPERA o provedor (abuso, falta de pagamento): o
  // cliente não consegue reativar pelo self-service.
  desativadaPeloOperador Boolean @default(false)
  criadoEm DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  usuarios     Usuario[]
  organizacoes Organizacao[] @relation("OrganizacoesDaAplicacao")
  webhooks     WebhookAplicacao[]

  @@index([organizacaoDonaId])
  @@map("aplicacoes")
}

// Par de chaves RS256 que assina o access token. Antes era uma só, em
// variável de ambiente, sem `kid` no header — o que tornava impossível
// rotacionar sem quebrar todo consumidor ao mesmo tempo (foi exatamente o que
// aconteceu quando o claim `aud` mudou). Como tabela, dá pra publicar a chave
// nova no JWKS, esperar o cache dos consumidores virar, e só então passar a
// assinar com ela.
model ChaveAssinatura {
  id  String @id @default(cuid())
  // Vai no header do JWT e identifica a entrada correspondente no JWKS.
  kid String @unique
  // SPKI PEM — material público, servido cru em /.well-known/jwks.json.
  publicaPem String
  // PKCS#8 PEM cifrado em repouso (AES-256-GCM, src/lib/cripto.ts). A chave
  // que cifra continua vindo de MFA_ENCRYPTION_KEY: o nome ficou estreito
  // demais pro que a função virou, mas inventar um segredo novo só pra isso
  // adicionaria mais uma env var pra esquecer de criar em produção — que é,
  // literalmente, o modo de falha que já derrubou este projeto duas vezes.
  privadaCifrada String
  // Assina os tokens NOVOS. No máximo uma linha ativa por vez; as demais
  // continuam publicadas no JWKS enquanto houver token vivo assinado por elas.
  ativa Boolean @default(false)
  // Quando deixou de assinar. Uma chave aposentada só pode sair do JWKS
  // depois de expirar o último token que assinou (vida do access token, 15
  // min) mais a janela de cache dos consumidores.
  aposentadaEm DateTime? @db.Timestamptz(3)
  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@map("chaves_assinatura")
}

// Papel de ORGANIZAÇÃO (dono/admin/membro de uma Organizacao) — separado do
// Papel de SISTEMA acima (Usuario.papel), que continua existindo pra quem
// opera a instalação inteira (painel de auditoria, /api/auth/usuarios).
// Um usuário pode ser "membro" numa organização e "admin" de sistema ao
// mesmo tempo — são eixos independentes.
enum PapelOrganizacao {
  dono
  admin
  membro
}

// Todo campo DateTime deste schema usa @db.Timestamptz — sem essa anotação
// o Prisma mapeia pra `timestamp` (SEM fuso) no Postgres, que grava só os
// números "de parede" sob o fuso da sessão (aqui sempre GMT, então o valor
// bate com UTC) mas devolve texto sem nenhuma marca de fuso. O node-postgres
// (postgres-date) então reconstrói esse texto com `new Date(ano, mes, dia, ...)`
// — o construtor de HORÁRIO LOCAL do processo que está lendo — em vez de
// UTC. Em Vercel (roda em UTC) isso coincide e não dá pra notar; rodando um
// script local no Brasil (UTC-3) ou qualquer outro fuso, a mesma linha lida
// chega ~3h adiantada. `timestamptz` elimina a ambiguidade: o valor sai do
// banco com o offset embutido, e o parser usa `Date.UTC(...)`, correto
// não importa o fuso de quem lê.
model Usuario {
  id             String              @id @default(cuid())
  // Aplicação cliente a que esta conta pertence. Identidade passa a ser POR
  // APLICAÇÃO: o mesmo e-mail pode existir em duas aplicações diferentes sem
  // colidir — é a diferença entre "o auth do meu app" e "auth como serviço".
  aplicacaoId    String
  // Restrict, não Cascade: apagar uma aplicação por acidente não pode levar
  // junto todas as contas dos usuários finais dela. Excluir um cliente é
  // operação deliberada, feita depois de esvaziar a aplicação.
  aplicacao      Aplicacao           @relation(fields: [aplicacaoId], references: [id], onDelete: Restrict)
  nome           String
  email          String
  senhaHash      String
  mfaAtivado     Boolean             @default(false)
  mfaSecret      String?
  // Timestep (contador de janelas de 30s desde a época) do último código
  // TOTP aceito — rejeita qualquer código com timestep <= esse valor,
  // impedindo reusar o mesmo código (ou um mais antigo) dentro da janela de
  // tolerância de ±30s. Timesteps sobem com o relógio, não por segredo, então
  // não precisa resetar ao gerar um segredo novo (mfa/iniciar).
  mfaUltimoTimestep Int?
  emailVerificado Boolean            @default(false)
  papel          Papel               @default(usuario)
  // As colunas legadas "suspenso", "suspensoAte" e "suspensoMotivo" saíram do
  // schema mas ainda existem na tabela: a suspensão passou a ser por
  // organização (ver Membro.suspenso, migration
  // 20260914120000_suspensao_por_membro). Remoção em DUAS publicações — (1)
  // este schema sem os campos, pro Prisma do código novo parar de
  // selecioná-los (colunas extras na tabela ele ignora); (2) só depois, a
  // migration com o DROP COLUMN. Derrubar junto com a troca de código quebraria
  // o login na janela entre a migration e o deploy, porque o código anterior
  // ainda as seleciona.
  // Marca a redefinição de senha mais recente: qualquer token de redefinição
  // emitido antes desse instante (comparado ao `iat` do JWT) deixa de valer.
  // É o que torna o token, que por si só é um JWT stateless reutilizável
  // dentro da janela de validade, de uso único na prática.
  senhaAlteradaEm DateTime?          @db.Timestamptz(3)
  // Mesma ideia do senhaAlteradaEm, para o link de confirmação de troca de
  // e-mail (JWT stateless de 1h): qualquer token de alteração com `iat`
  // anterior a esse instante é rejeitado, tornando o link de uso único.
  emailAlteradoEm DateTime?          @db.Timestamptz(3)
  criadoEm       DateTime            @default(now()) @db.Timestamptz(3)
  atualizadoEm   DateTime            @updatedAt @db.Timestamptz(3)
  tokens         TokenAtualizacao[]
  codigosBackup  CodigoBackupMfa[]
  dispositivosConfiaveis DispositivoConfiavel[]
  passkeys       PasskeyCredencial[]
  codigosAutorizacao CodigoAutorizacao[]
  // Organizações de que este usuário participa (dono, admin ou membro) —
  // ver Membro abaixo. Multi-tenant: um usuário pode pertencer a várias.
  membros        Membro[]
  // Convites que este usuário mandou (ver ConviteOrganizacao.criadoPorId) —
  // não é "convites que este usuário recebeu" (esses são por e-mail, sem
  // conta necessariamente existir ainda).
  convitesCriados ConviteOrganizacao[]

  // O índice único que define o produto: e-mail é único DENTRO da aplicação,
  // não no sistema. joao@empresa.com pode ser usuário final de dois clientes
  // diferentes sem que um saiba do outro. Antes era `email @unique` global,
  // que é o certo pra um app de primeira parte e o impeditivo pra um provedor.
  @@unique([aplicacaoId, email])
  // Suporta "todas as contas desta aplicação" (listagem administrativa) sem
  // depender do índice composto acima, que exige o e-mail.
  @@index([aplicacaoId])
  @@map("usuarios")
}

model TokenAtualizacao {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  usuarioId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Organização ATIVA desta sessão (a que o access token reemitido em
  // /api/auth/atualizar carrega no claim organizacaoId) — nullable só pelas
  // sessões emitidas ANTES desta coluna existir; toda sessão nova (login,
  // conclusão de MFA, troca de organização) sempre preenche. Sessões velhas
  // sem organizacaoId expiram sozinhas (refresh token dura no máximo 30
  // dias), não precisou de backfill como Projeto/Tarefa no Django.
  organizacaoId String?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  // IP, User-Agent e geolocalização capturados no momento em que ESTA linha
  // foi criada (login, conclusão de MFA ou rotação em /atualizar) — exibidos
  // na lista de "sessões ativas" pra o usuário reconhecer cada dispositivo.
  // Geolocalização vem dos headers `x-vercel-ip-*` que a Vercel injeta nas
  // requisições (ver src/lib/geo.ts); ficam null fora da Vercel (dev local).
  ip           String?
  userAgent    String?
  geoCidade    String?
  geoRegiao    String?
  geoPais      String?
  criadoEm     DateTime  @default(now()) @db.Timestamptz(3)
  expiraEm     DateTime  @db.Timestamptz(3)
  revogadoEm   DateTime? @db.Timestamptz(3)
  // Por que foi revogada (ver src/lib/revogacao.ts). Só a revogação por
  // ROTAÇÃO faz a reapresentação do token contar como roubo; nulo = revogada
  // antes desta coluna existir, tratada como rotação.
  revogadoMotivo String?
  // Escopos concedidos no login hospedado (OpenID Connect) que abriu esta
  // sessão. Vai no access token (claim `scope`) e passa adiante a cada
  // rotação, pro /api/oidc/userinfo respeitar o que a pessoa autorizou. Nulo
  // = sessão fora do OIDC (painel, SDK).
  escopoOidc String?

  @@index([usuarioId])
  @@index([organizacaoId])
  @@map("tokens_atualizacao")
}

// Código de backup (recovery code) de MFA: segundo fator alternativo pra
// quando o usuário perde o autenticador TOTP. Só o hash fica no banco — o
// texto puro é exibido uma única vez, no momento da geração.
model CodigoBackupMfa {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String    @unique
  usadoEm    DateTime? @db.Timestamptz(3)
  criadoEm   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([usuarioId])
  @@map("codigos_backup_mfa")
}

// Torna o desafio de MFA (mfaToken) de uso único: mesmo sendo um JWT
// stateless válido por até 5 min, o jti só pode completar UMA tentativa
// bem-sucedida (TOTP ou código de backup) — insert com jti como chave
// única, então uma segunda tentativa esbarra na constraint. expiraEm
// espelha o `exp` do próprio JWT, só pra permitir limpeza periódica das
// linhas já vencidas (o job de limpeza de tokens pode incluir esta tabela).
model DesafioMfaConsumido {
  jti      String   @id
  expiraEm DateTime @db.Timestamptz(3)

  @@map("desafios_mfa_consumidos")
}

// "Lembrar este dispositivo": pula o desafio de MFA por N dias num navegador
// já verificado (a senha ainda é exigida em todo login) — token de posse
// comum, mesmo padrão do TokenAtualizacao (só o hash fica no banco).
model DispositivoConfiavel {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)
  expiraEm  DateTime @db.Timestamptz(3)

  @@index([usuarioId])
  @@map("dispositivos_confiaveis")
}

// Passkey (WebAuthn) — login sem senha, resistente a phishing (a assinatura
// é atrelada à origem verificada pelo browser, então uma página clonada não
// consegue arrancar uma assinatura válida). Complementa a senha: quem
// cadastra uma passkey continua com a senha funcionando também (ela não é
// desativada), e o login por passkey já vale como sessão completa, sem
// precisar do desafio de TOTP separado — a posse do autenticador + presença
// do usuário (biometria/PIN local) já cobre o segundo fator.
model PasskeyCredencial {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // ID do credential (base64url) gerado pelo authenticator — é o que o
  // browser manda de volta em cada login, usado pra achar a linha certa
  // ANTES de saber quem está logando (login sem digitar e-mail).
  credentialId String   @unique
  // Chave pública COSE (formato binário) usada pra verificar a assinatura em
  // cada autenticação futura — nunca a chave privada, que não sai do
  // authenticator.
  publicKey String
  // Contador de assinaturas do authenticator: precisa SUBIR a cada uso. Se
  // vier igual ou menor que o salvo, é sinal de um clone da credencial
  // (authenticator genuíno nunca reusa/retrocede o contador).
  contador    Int      @default(0)
  transportes String[]
  // Apelido escolhido pelo usuário (ex.: "Touch ID do MacBook") — sem isso,
  // a lista de passkeys na tela de segurança seria só uma lista de datas.
  nome        String?
  criadoEm    DateTime  @default(now()) @db.Timestamptz(3)
  ultimoUsoEm DateTime? @db.Timestamptz(3)

  @@index([usuarioId])
  @@map("passkeys")
}

model LogAuditoria {
  id        String   @id @default(cuid())
  // Escopo da trilha. Sem estes dois campos, um dono de organização não
  // consegue ver a própria auditoria (a rota checa só o papel de sistema) e
  // quem opera a instalação vê a de todos os clientes de uma vez — aceitável
  // num app de primeira parte, inaceitável num provedor. Ficam soltos (sem
  // relation) pelo mesmo motivo que autorId/autorEmail: é trilha histórica,
  // tem que sobreviver à exclusão do que ela descreve.
  aplicacaoId   String?
  organizacaoId String?
  usuarioId String?
  email     String?
  evento    String
  ip        String?
  userAgent String?
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)
  // Preenchidos só quando o ator é diferente do alvo (ex.: admin suspendendo
  // OUTRA conta) — nesses eventos usuarioId/email acima seguem descrevendo o
  // ALVO da ação, como já faziam antes; sem autorId não dava pra saber QUEM
  // suspendeu/reativou/excluiu, só o quê aconteceu com quem.
  autorId    String?
  autorEmail String?
  // O que a ação alterou quando o alvo não é uma conta — ex.:
  // "aplicacao:app_123 (Loja Acme)" na gestão de aplicações. usuarioId/email
  // descrevem uma pessoa e não servem pra dizer QUAL cliente foi editado.
  alvo       String?

  @@index([usuarioId])
  @@index([evento, ip, criadoEm])
  // Suporte ao rate limit por CONTA (complementa o por IP): protege contra
  // ataque distribuído mirando um único e-mail a partir de vários IPs, que
  // nenhum limite por IP isolado detectaria.
  @@index([evento, email, criadoEm])
  // Poda de retenção (LGPD): o job de limpeza apaga registros com mais de N
  // dias — sem este índice o DELETE varre a tabela inteira.
  @@index([criadoEm])
  // Painel de auditoria escopado: "os eventos desta organização, mais
  // recentes primeiro" e o mesmo por aplicação, sem varrer a tabela toda.
  @@index([aplicacaoId, criadoEm])
  @@index([organizacaoId, criadoEm])
  @@map("logs_auditoria")
}

// Contador dedicado de rate limit: uma linha por chave (ip/e-mail + evento),
// incrementada atomicamente em janela fixa (ver incrementar() em
// src/lib/rateLimit.ts) — substitui o count() sobre LogAuditoria que rodava
// a cada tentativa de login/cadastro/redefinição. LogAuditoria continua
// existindo do mesmo jeito pra trilha permanente (outro propósito: histórico
// pra investigação, não contagem); esta tabela é só um contador efêmero, sem
// valor histórico — expiraEm é tanto o fim da janela quanto o critério de
// poda do job de limpeza.
model LimiteTaxa {
  chave    String   @id
  contagem Int      @default(1)
  expiraEm DateTime @db.Timestamptz(3)

  @@index([expiraEm])
  @@map("limites_taxa")
}

// Webhook de uma aplicação cliente: o provedor avisa o sistema do cliente
// quando algo acontece com as contas dele (conta criada, senha alterada,
// suspensão...). Ver src/lib/webhooks.ts.
model WebhookAplicacao {
  id          String    @id @default(cuid())
  aplicacaoId String
  aplicacao   Aplicacao @relation(fields: [aplicacaoId], references: [id], onDelete: Cascade)
  url         String
  // Segredo HMAC que assina cada entrega. Cifrado em repouso (e não só em
  // hash, como o client secret): o provedor precisa dele em texto pra assinar.
  segredoCifrado String
  eventos     String[]
  ativo       Boolean   @default(true)
  // Preenchido quando o próprio provedor desligou o webhook (entregas
  // seguidas desistidas): o painel mostra o motivo e o gestor religa.
  desativadoMotivo String?
  criadoEm    DateTime  @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)
  entregas    EntregaWebhook[]

  @@index([aplicacaoId])
  @@map("webhooks_aplicacao")
}

// Uma tentativa de avisar um webhook. Persistida antes de enviar: se o sistema
// do cliente estiver fora do ar, o job de limpeza tenta de novo com espera
// crescente, e o painel mostra o histórico.
model EntregaWebhook {
  id                 String           @id @default(cuid())
  webhookId          String
  webhook            WebhookAplicacao @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  evento             String
  payload            Json
  tentativas         Int              @default(0)
  proximaTentativaEm DateTime         @default(now()) @db.Timestamptz(3)
  entregueEm         DateTime?        @db.Timestamptz(3)
  desistiuEm         DateTime?        @db.Timestamptz(3)
  ultimoStatus       Int?
  ultimoErro         String?
  criadoEm           DateTime         @default(now()) @db.Timestamptz(3)

  @@index([webhookId, criadoEm])
  @@index([entregueEm, desistiuEm, proximaTentativaEm])
  @@map("entregas_webhook")
}

// Código de autorização do login hospedado (OpenID Connect, src/lib/oidc.ts).
// Vida de 60 s e uso único; só o hash fica no banco. Preso à aplicação, ao
// redirect_uri e ao code_challenge do pedido que o gerou — o /token confere os
// três. `sessaoId` liga o código à sessão emitida na troca: reapresentar um
// código já usado revoga essa sessão (RFC 6749 §4.1.2), porque quem tem o
// código duas vezes pode ser quem o interceptou.
model CodigoAutorizacao {
  id            String    @id @default(cuid())
  codigoHash    String    @unique
  aplicacaoId   String
  usuarioId     String
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  redirectUri   String
  escopo        String
  nonce         String?
  codeChallenge String
  autenticadoEm DateTime  @db.Timestamptz(3)
  expiraEm      DateTime  @db.Timestamptz(3)
  usadoEm       DateTime? @db.Timestamptz(3)
  // Alguém apresentou o código de novo depois de usado. A troca que ainda está
  // em andamento confere este campo DEPOIS de criar a sessão e a revoga — fecha
  // a corrida em que a reapresentação chega antes de existir sessão a derrubar.
  reapresentadoEm DateTime? @db.Timestamptz(3)
  sessaoId      String?
  criadoEm      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([expiraEm])
  @@map("codigos_autorizacao")
}

// Organização excluída aqui cujos projetos e tarefas ainda precisam sair do
// serviço Django (schema dominio, sem FK entre os serviços). A linha nasce na
// MESMA transação que apaga a organização e só some quando o Django confirma
// a exclusão — se ele estiver fora do ar, o job de limpeza tenta de novo. Sem
// isso, excluir a conta deixava dado pessoal órfão do outro lado (LGPD).
//
// `alvo` é "organizacao:<id>" (projetos e tarefas da organização) ou
// "usuario:<id>" (projetos e tarefas LEGADOS da conta, de antes do
// multi-tenant, que ficaram sem organizacao_id e não seriam alcançados pela
// organização).
model ExclusaoDominioPendente {
  alvo       String   @id
  tentativas Int      @default(0)
  ultimoErro String?
  criadoEm   DateTime @default(now()) @db.Timestamptz(3)

  @@map("exclusoes_dominio_pendentes")
}

// Multi-tenant: uma conta (Usuario) pode pertencer a várias organizações
// (Membro), cada uma com seus próprios dados (Projeto/Tarefa no Django,
// isolados por organizacao_id — ver django/tarefas/models.py) e seu próprio
// papel (dono/admin/membro, PapelOrganizacao). A organização ATIVA de uma
// sessão vai no claim `organizacaoId` do access token (ver
// src/lib/token.ts) — trocar de organização reemite os tokens, não troca
// contexto dentro do mesmo token (ver decisão de design no plano de
// implementação: o Django só confia no JWT, nunca consulta esta tabela
// diretamente).
model Organizacao {
  id       String   @id @default(cuid())
  // Uma organização vive dentro de UMA aplicação cliente — os dois níveis de
  // isolamento do provedor: a aplicação (o cliente que paga) e, dentro dela,
  // as organizações dos usuários finais desse cliente.
  aplicacaoId String
  aplicacao   Aplicacao @relation("OrganizacoesDaAplicacao", fields: [aplicacaoId], references: [id], onDelete: Restrict)
  nome     String
  // Usado em URLs/exibição — único DENTRO da aplicação, não globalmente:
  // senão o cliente A que registrasse "acme" impediria o cliente B de usar o
  // mesmo slug, vazando a existência de uma organização de outro cliente pela
  // colisão. Mesmo raciocínio do índice de e-mail em Usuario.
  slug     String
  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  membros  Membro[]
  convites ConviteOrganizacao[]
  sessoes  TokenAtualizacao[]
  // Aplicações clientes que esta organização criou pelo painel (self-service).
  aplicacoesProprias Aplicacao[] @relation("AplicacoesDaOrganizacao")

  @@unique([aplicacaoId, slug])
  @@index([aplicacaoId])
  @@map("organizacoes")
}

// Associação usuário<->organização com papel — é a tabela que o RBAC de
// organização consulta (ver src/lib/rbacOrganizacao.ts). Um par
// (organizacaoId, usuarioId) só pode existir uma vez: um usuário tem UM
// papel por organização, não papéis cumulativos.
model Membro {
  id            String           @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao      @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  papel         PapelOrganizacao @default(membro)
  // Suspensão DENTRO desta organização. Quem suspende é dono/admin da
  // organização, então o efeito fica nela: a pessoa continua entrando nas
  // outras organizações de que participa (inclusive a pessoal). suspensoAte
  // null + suspenso true = permanente; suspensoAte no passado = suspensão
  // expirada (volta a valer sozinha, sem reativação manual nem job).
  suspenso       Boolean          @default(false)
  suspensoAte    DateTime?        @db.Timestamptz(3)
  suspensoMotivo String?
  criadoEm      DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([organizacaoId, usuarioId])
  // Suporta "de quais organizações este usuário é membro" (seletor de
  // organização, tela de cadastro/login quando há mais de uma).
  @@index([usuarioId])
  @@map("membros")
}

// Convite pendente pra alguém entrar numa organização — token stateless
// (JWT, mesmo padrão de gerarTokenVerificacaoEmail/gerarTokenRedefinicaoSenha
// em token.ts) mandado por e-mail; esta linha existe só pra listar convites
// pendentes na UI e pra invalidar (aceitoEm) o reuso do mesmo convite depois
// de aceito — o token em si não é persistido aqui (mesma lógica dos outros
// tokens stateless do projeto: o jti/claims bastam pra validar).
model ConviteOrganizacao {
  id            String           @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao      @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  email         String
  papel         PapelOrganizacao @default(membro)
  // Quem convidou — relation de verdade (diferente do autorId solto em
  // LogAuditoria, que é trilha histórica). Um convite PENDENTE ainda tem
  // efeito prático (alguém pode aceitá-lo), então excluir a conta de quem
  // convidou não deveria matar o convite — só onDelete: SetNull, não
  // Cascade: a organização continua querendo essa pessoa dentro mesmo que
  // quem mandou o convite tenha saído nesse meio-tempo.
  criadoPorId   String?
  criadoPor     Usuario?         @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  aceitoEm      DateTime?        @db.Timestamptz(3)
  criadoEm      DateTime         @default(now()) @db.Timestamptz(3)

  @@index([organizacaoId])
  // Suporta "convites pendentes pra este e-mail" na tela de cadastro/login.
  @@index([email])
  @@map("convites_organizacao")
}
