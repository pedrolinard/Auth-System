// Schema do Prisma - Sistema de Autenticação Intermediária
// Saiba mais em: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  usuario
  admin
}

// Todo campo DateTime deste schema usa @db.Timestamptz — sem essa anotação
// o Prisma mapeia pra `timestamp` (SEM fuso) no Postgres, que grava só os
// números "de parede" sob o fuso da sessão (aqui sempre GMT, então o valor
// bate com UTC) mas devolve texto sem nenhuma marca de fuso. O node-postgres
// (postgres-date) então reconstrói esse texto com `new Date(ano, mes, dia, ...)`
// — o construtor de HORÁRIO LOCAL do processo que está lendo — em vez de
// UTC. Em Vercel (roda em UTC) isso coincide e não dá pra notar; rodando um
// script local no Brasil (UTC-3) ou qualquer outro fuso, a mesma linha lida
// chega ~3h adiantada. `timestamptz` elimina a ambiguidade: o valor sai do
// banco com o offset embutido, e o parser usa `Date.UTC(...)`, correto
// não importa o fuso de quem lê.
model Usuario {
  id             String              @id @default(cuid())
  nome           String
  email          String              @unique
  senhaHash      String
  mfaAtivado     Boolean             @default(false)
  mfaSecret      String?
  // Timestep (contador de janelas de 30s desde a época) do último código
  // TOTP aceito — rejeita qualquer código com timestep <= esse valor,
  // impedindo reusar o mesmo código (ou um mais antigo) dentro da janela de
  // tolerância de ±30s. Timesteps sobem com o relógio, não por segredo, então
  // não precisa resetar ao gerar um segredo novo (mfa/iniciar).
  mfaUltimoTimestep Int?
  emailVerificado Boolean            @default(false)
  papel          Papel               @default(usuario)
  // suspensoAte null + suspenso true = suspensão permanente; suspensoAte no
  // passado é tratado como suspensão expirada (login volta a funcionar sem
  // precisar de reativação manual nem de job de limpeza).
  suspenso       Boolean             @default(false)
  suspensoAte    DateTime?           @db.Timestamptz(3)
  suspensoMotivo String?
  // Marca a redefinição de senha mais recente: qualquer token de redefinição
  // emitido antes desse instante (comparado ao `iat` do JWT) deixa de valer.
  // É o que torna o token, que por si só é um JWT stateless reutilizável
  // dentro da janela de validade, de uso único na prática.
  senhaAlteradaEm DateTime?          @db.Timestamptz(3)
  criadoEm       DateTime            @default(now()) @db.Timestamptz(3)
  atualizadoEm   DateTime            @updatedAt @db.Timestamptz(3)
  tokens         TokenAtualizacao[]
  codigosBackup  CodigoBackupMfa[]
  dispositivosConfiaveis DispositivoConfiavel[]
  passkeys       PasskeyCredencial[]

  @@map("usuarios")
}

model TokenAtualizacao {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  usuarioId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // IP, User-Agent e geolocalização capturados no momento em que ESTA linha
  // foi criada (login, conclusão de MFA ou rotação em /atualizar) — exibidos
  // na lista de "sessões ativas" pra o usuário reconhecer cada dispositivo.
  // Geolocalização vem dos headers `x-vercel-ip-*` que a Vercel injeta nas
  // requisições (ver src/lib/geo.ts); ficam null fora da Vercel (dev local).
  ip           String?
  userAgent    String?
  geoCidade    String?
  geoRegiao    String?
  geoPais      String?
  criadoEm     DateTime  @default(now()) @db.Timestamptz(3)
  expiraEm     DateTime  @db.Timestamptz(3)
  revogadoEm   DateTime? @db.Timestamptz(3)

  @@index([usuarioId])
  @@map("tokens_atualizacao")
}

// Código de backup (recovery code) de MFA: segundo fator alternativo pra
// quando o usuário perde o autenticador TOTP. Só o hash fica no banco — o
// texto puro é exibido uma única vez, no momento da geração.
model CodigoBackupMfa {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String    @unique
  usadoEm    DateTime? @db.Timestamptz(3)
  criadoEm   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([usuarioId])
  @@map("codigos_backup_mfa")
}

// Torna o desafio de MFA (mfaToken) de uso único: mesmo sendo um JWT
// stateless válido por até 5 min, o jti só pode completar UMA tentativa
// bem-sucedida (TOTP ou código de backup) — insert com jti como chave
// única, então uma segunda tentativa esbarra na constraint. expiraEm
// espelha o `exp` do próprio JWT, só pra permitir limpeza periódica das
// linhas já vencidas (o job de limpeza de tokens pode incluir esta tabela).
model DesafioMfaConsumido {
  jti      String   @id
  expiraEm DateTime @db.Timestamptz(3)

  @@map("desafios_mfa_consumidos")
}

// "Lembrar este dispositivo": pula o desafio de MFA por N dias num navegador
// já verificado (a senha ainda é exigida em todo login) — token de posse
// comum, mesmo padrão do TokenAtualizacao (só o hash fica no banco).
model DispositivoConfiavel {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)
  expiraEm  DateTime @db.Timestamptz(3)

  @@index([usuarioId])
  @@map("dispositivos_confiaveis")
}

// Passkey (WebAuthn) — login sem senha, resistente a phishing (a assinatura
// é atrelada à origem verificada pelo browser, então uma página clonada não
// consegue arrancar uma assinatura válida). Complementa a senha: quem
// cadastra uma passkey continua com a senha funcionando também (ela não é
// desativada), e o login por passkey já vale como sessão completa, sem
// precisar do desafio de TOTP separado — a posse do autenticador + presença
// do usuário (biometria/PIN local) já cobre o segundo fator.
model PasskeyCredencial {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // ID do credential (base64url) gerado pelo authenticator — é o que o
  // browser manda de volta em cada login, usado pra achar a linha certa
  // ANTES de saber quem está logando (login sem digitar e-mail).
  credentialId String   @unique
  // Chave pública COSE (formato binário) usada pra verificar a assinatura em
  // cada autenticação futura — nunca a chave privada, que não sai do
  // authenticator.
  publicKey String
  // Contador de assinaturas do authenticator: precisa SUBIR a cada uso. Se
  // vier igual ou menor que o salvo, é sinal de um clone da credencial
  // (authenticator genuíno nunca reusa/retrocede o contador).
  contador    Int      @default(0)
  transportes String[]
  // Apelido escolhido pelo usuário (ex.: "Touch ID do MacBook") — sem isso,
  // a lista de passkeys na tela de segurança seria só uma lista de datas.
  nome        String?
  criadoEm    DateTime  @default(now()) @db.Timestamptz(3)
  ultimoUsoEm DateTime? @db.Timestamptz(3)

  @@index([usuarioId])
  @@map("passkeys")
}

model LogAuditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  email     String?
  evento    String
  ip        String?
  userAgent String?
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)
  // Preenchidos só quando o ator é diferente do alvo (ex.: admin suspendendo
  // OUTRA conta) — nesses eventos usuarioId/email acima seguem descrevendo o
  // ALVO da ação, como já faziam antes; sem autorId não dava pra saber QUEM
  // suspendeu/reativou/excluiu, só o quê aconteceu com quem.
  autorId    String?
  autorEmail String?

  @@index([usuarioId])
  @@index([evento, ip, criadoEm])
  // Suporte ao rate limit por CONTA (complementa o por IP): protege contra
  // ataque distribuído mirando um único e-mail a partir de vários IPs, que
  // nenhum limite por IP isolado detectaria.
  @@index([evento, email, criadoEm])
  @@map("logs_auditoria")
}
