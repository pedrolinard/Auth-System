{
  "name": "@grupocz/auth-gateway-sdk",
  "version": "0.1.0",
  "description": "Cliente e verificador de token para aplicações que integram com o Auth Gateway.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cliente": {
      "types": "./dist/cliente.d.ts",
      "default": "./dist/cliente.js"
    },
    "./servidor": {
      "types": "./dist/servidor.d.ts",
      "default": "./dist/servidor.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrolinard/Auth-System.git",
    "directory": "sdk"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "jose": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "jose": {
      "optional": true
    }
  },
  "devDependencies": {
    "jose": "^6.0.0",
    "typescript": "^5"
  }
}
